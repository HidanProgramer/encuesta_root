<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_encuesta_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">

                    <style>
                        /* ── Paleta y tipografía ── */
                        :root {
                            --azul:      #0d3b6e;
                            --azul-med:  #1565c0;
                            --azul-cla:  #e8f0fe;
                            --acento:    #00897b;
                            --gris-osc:  #263238;
                            --gris-med:  #546e7a;
                            --gris-cla:  #f4f6f9;
                            --borde:     #cfd8dc;
                            --blanco:    #ffffff;
                        }

                        body, .page {
                            font-family: 'DejaVu Sans', Arial, sans-serif;
                            font-size: 12px;
                            color: var(--gris-osc);
                            background: var(--blanco);
                        }

                        /* ── Encabezado del expediente ── */
                        .exp-header {
                            display: flex;
                            align-items: stretch;
                            border: 2px solid var(--azul);
                            border-radius: 6px;
                            overflow: hidden;
                            margin-bottom: 20px;
                        }
                        .exp-header-brand {
                            background: var(--azul);
                            color: var(--blanco);
                            width: 8px;
                            flex-shrink: 0;
                        }
                        .exp-header-body {
                            flex: 1;
                            padding: 14px 18px;
                        }
                        .exp-header-title {
                            font-size: 16px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 1.5px;
                            color: var(--azul);
                            margin: 0 0 4px 0;
                        }
                        .exp-header-sub {
                            font-size: 11px;
                            color: var(--gris-med);
                            margin: 0;
                        }
                        .exp-header-meta {
                            display: flex;
                            gap: 28px;
                            margin-top: 10px;
                            font-size: 11px;
                        }
                        .exp-meta-item strong {
                            display: block;
                            font-size: 9px;
                            text-transform: uppercase;
                            letter-spacing: 0.8px;
                            color: var(--gris-med);
                            margin-bottom: 1px;
                        }
                        .exp-badge {
                            display: inline-block;
                            padding: 3px 10px;
                            border-radius: 20px;
                            font-size: 10px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            background: var(--azul-cla);
                            color: var(--azul-med);
                            border: 1px solid var(--azul-med);
                        }

                        /* ── Secciones ── */
                        .seccion {
                            margin-bottom: 18px;
                        }
                        .seccion-titulo {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            margin-bottom: 10px;
                            padding-bottom: 5px;
                            border-bottom: 2px solid var(--azul-med);
                        }
                        .seccion-num {
                            background: var(--azul-med);
                            color: var(--blanco);
                            font-size: 10px;
                            font-weight: 700;
                            width: 22px;
                            height: 22px;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            flex-shrink: 0;
                        }
                        .seccion-titulo h4 {
                            margin: 0;
                            font-size: 12px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.8px;
                            color: var(--azul);
                        }

                        /* ── Tablas ── */
                        .tabla-datos {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 11px;
                        }
                        .tabla-datos th {
                            background: var(--azul);
                            color: var(--blanco);
                            padding: 6px 10px;
                            font-weight: 600;
                            text-align: center;
                            font-size: 10px;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }
                        .tabla-datos td {
                            padding: 6px 10px;
                            border-bottom: 1px solid var(--borde);
                            text-align: center;
                        }
                        .tabla-datos tbody tr:nth-child(even) td {
                            background: var(--gris-cla);
                        }
                        .tabla-datos .subtitulo-grupo th {
                            background: var(--azul-med);
                            font-size: 10px;
                        }

                        /* ── Grid de datos clave ── */
                        .grid-info {
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 8px;
                            margin-bottom: 10px;
                        }
                        .info-bloque {
                            background: var(--gris-cla);
                            border-left: 3px solid var(--azul-med);
                            padding: 8px 12px;
                            border-radius: 0 4px 4px 0;
                        }
                        .info-bloque label {
                            display: block;
                            font-size: 9px;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: var(--gris-med);
                            margin-bottom: 2px;
                        }
                        .info-bloque span {
                            font-size: 12px;
                            font-weight: 600;
                            color: var(--gris-osc);
                        }

                        /* ── Foto integrada ── */
                        .foto-contenedor {
                            margin-top: 12px;
                            border: 1px solid var(--borde);
                            border-radius: 6px;
                            overflow: hidden;
                        }
                        .foto-header {
                            background: var(--gris-cla);
                            border-bottom: 1px solid var(--borde);
                            padding: 5px 12px;
                            font-size: 10px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: var(--gris-med);
                        }
                        .foto-cuerpo {
                            padding: 10px;
                            text-align: center;
                        }
                        .foto-cuerpo img {
                            max-width: 100%;
                            max-height: 280px;
                            object-fit: contain;
                            border-radius: 4px;
                        }
                        .foto-placeholder {
                            padding: 18px;
                            border: 1px dashed var(--borde);
                            border-radius: 4px;
                            color: var(--gris-med);
                            font-size: 11px;
                            font-style: italic;
                        }

                        /* ── Mapa ── */
                        .mapa-contenedor {
                            border: 1px solid var(--azul-med);
                            border-radius: 6px;
                            overflow: hidden;
                            margin-top: 12px;
                        }
                        .mapa-header {
                            background: var(--azul-cla);
                            border-bottom: 1px solid var(--azul-med);
                            padding: 5px 12px;
                            font-size: 10px;
                            font-weight: 700;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: var(--azul-med);
                        }
                        .mapa-cuerpo {
                            padding: 10px;
                            text-align: center;
                        }
                        .mapa-cuerpo img {
                            max-width: 100%;
                            border-radius: 4px;
                        }
                        .mapa-credito {
                            font-size: 8px;
                            color: var(--gris-med);
                            margin-top: 5px;
                        }

                        /* ── Criterios ── */
                        .criterios-grid {
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 6px;
                        }
                        .criterio-fila {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            background: var(--gris-cla);
                            border-radius: 4px;
                            padding: 6px 10px;
                            font-size: 11px;
                        }
                        .criterio-fila .val {
                            font-weight: 700;
                            color: var(--azul-med);
                        }

                        /* ── Aspectos limitantes ── */
                        .limitantes-grid {
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 6px;
                        }
                        .limitante-item {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            border: 1px solid var(--borde);
                            border-radius: 4px;
                            padding: 6px 10px;
                            font-size: 11px;
                        }
                        .limitante-item .prio {
                            font-weight: 700;
                            color: var(--acento);
                        }

                        /* ── Dictamen final ── */
                        .dictamen {
                            background: var(--azul-cla);
                            border-left: 4px solid var(--azul);
                            border-radius: 0 6px 6px 0;
                            padding: 12px 16px;
                            margin-top: 16px;
                            font-size: 11px;
                        }
                        .dictamen label {
                            display: block;
                            font-size: 9px;
                            text-transform: uppercase;
                            letter-spacing: 0.8px;
                            color: var(--gris-med);
                            margin-bottom: 3px;
                            margin-top: 8px;
                        }
                        .dictamen label:first-child { margin-top: 0; }
                        .dictamen p { margin: 0; font-weight: 600; color: var(--gris-osc); }

                        /* ── Fotos de equipos ── */
                        .equipos-fotos {
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 10px;
                            margin-top: 12px;
                        }

                        /* ── Croquis final ── */
                        .croquis-contenedor {
                            margin-top: 12px;
                            text-align: center;
                        }
                        .croquis-contenedor img {
                            max-width: 100%;
                            max-height: 400px;
                            object-fit: contain;
                            border: 1px solid var(--borde);
                            border-radius: 6px;
                        }
                    </style>

                    <div class="page">

                        <!-- ══════════════════════════════════════════
                             ENCABEZADO DEL EXPEDIENTE
                        ══════════════════════════════════════════ -->
                        <div class="exp-header">
                            <div class="exp-header-brand"/>
                            <div class="exp-header-body">
                                <p class="exp-header-title">Expediente de Encuesta Técnica</p>
                                <p class="exp-header-sub">
                                    Sistema Propuesto: <span t-field="doc.sistema_recomendado"/>
                                </p>
                                <div class="exp-header-meta">
                                    <div class="exp-meta-item">
                                        <strong>Cliente</strong>
                                        <span t-field="doc.cliente"/>
                                    </div>
                                    <div class="exp-meta-item">
                                        <strong>C.I.</strong>
                                        <span t-field="doc.ci"/>
                                    </div>
                                    <div class="exp-meta-item">
                                        <strong>Fecha de Encuesta</strong>
                                        <span t-field="doc.fecha_enc"/>
                                    </div>
                                    <div class="exp-meta-item">
                                        <strong>Estado de Evaluación</strong>
                                        <span class="exp-badge" t-field="doc.estado_evaluacion"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 1 — UBICACIÓN DE LA VIVIENDA
                        ══════════════════════════════════════════ -->
                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">1</div>
                                <h4>Ubicación de la Vivienda</h4>
                            </div>

                            <table class="tabla-datos">
                                <thead>
                                    <tr>
                                        <th>Municipio</th>
                                        <th>Consejo Popular</th>
                                        <th>Comunidad</th>
                                        <th>Latitud</th>
                                        <th>Longitud</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span t-field="doc.municipio_id.name"/></td>
                                        <td><span t-field="doc.consejo_popular_id.name"/></td>
                                        <td><span t-field="doc.comunidad_id.name"/></td>
                                        <td><span t-field="doc.latitud"/></td>
                                        <td><span t-field="doc.longitud"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Foto de la Vivienda -->
                            <div class="foto-contenedor">
                                <div class="foto-header">📷 Fotografía de la Vivienda</div>
                                <div class="foto-cuerpo">
                                    <t t-if="doc.foto_vivienda">
                                        <img t-att-src="image_data_uri(doc.foto_vivienda)"
                                             alt="Fotografía de la vivienda"/>
                                    </t>
                                    <t t-else="">
                                        <div class="foto-placeholder">
                                            No se adjuntó fotografía de la vivienda.
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Mapa de ubicación -->
                            <div class="mapa-contenedor">
                                <div class="mapa-header">🗺 Mapa de Ubicación</div>
                                <div class="mapa-cuerpo">
                                    <t t-if="doc.mapa_imagen">
                                        <img t-att-src="image_data_uri(doc.mapa_imagen)"
                                             alt="Mapa de ubicación"/>
                                        <p class="mapa-credito">
                                            Maps by <a href="https://locationiq.com">LocationIQ.com</a>
                                        </p>
                                    </t>
                                    <t t-else="">
                                        <div class="foto-placeholder">
                                            El mapa se generará automáticamente al guardar el formulario.
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 2 — CARACTERÍSTICAS DE LA VIVIENDA
                        ══════════════════════════════════════════ -->
                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">2</div>
                                <h4>Características de la Vivienda</h4>
                            </div>

                            <div class="grid-info">
                                <div class="info-bloque">
                                    <label>Tipo de Vivienda</label>
                                    <span t-field="doc.tipo_vivienda"/>
                                </div>
                                <div class="info-bloque">
                                    <label>Condición General</label>
                                    <span t-field="doc.condicion_vivienda"/>
                                </div>
                                <div class="info-bloque">
                                    <label>Materiales</label>
                                    <span>
                                        <t t-if="doc.material_madera">Madera </t>
                                        <t t-if="doc.material_mamposteria">Mampostería </t>
                                        <t t-if="doc.material_otro"><span t-field="doc.otro_material"/></t>
                                    </span>
                                </div>
                                <div class="info-bloque">
                                    <label>Divisiones Internas</label>
                                    <span>
                                        <t t-if="doc.divisiones">
                                            <t t-if="doc.sala">Sala </t>
                                            <t t-if="doc.comedor">Comedor </t>
                                            <t t-if="doc.cocina">Cocina </t>
                                            <t t-if="doc.cuartos">Cuartos </t>
                                            <t t-if="doc.banos">Baños</t>
                                        </t>
                                        <t t-else="">No posee</t>
                                    </span>
                                </div>
                                <t t-if="doc.tipo_vivienda == 'finca'">
                                    <div class="info-bloque">
                                        <label>Tipo de Actividad (Finca)</label>
                                        <span t-field="doc.tipo_finca"/>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Salto de página -->
                        <p style="page-break-before: always;"> </p>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 3 — SERVICIO ELÉCTRICO Y NÚCLEO FAMILIAR
                        ══════════════════════════════════════════ -->
                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">3</div>
                                <h4>Servicio Eléctrico y Núcleo Familiar</h4>
                            </div>

                            <div class="info-bloque" style="margin-bottom: 10px;">
                                <label>Tipo de Servicio Energético Actual</label>
                                <span t-field="doc.tipo_servicio_energetico"/>
                            </div>

                            <table class="tabla-datos">
                                <thead>
                                    <tr>
                                        <th colspan="4">
                                            Miembros del Hogar — Total:
                                            <span t-field="doc.total_personas"/> personas
                                        </th>
                                    </tr>
                                    <tr class="subtitulo-grupo">
                                        <th>Parentesco / Grupo</th>
                                        <th>Sexo</th>
                                        <th>Edad</th>
                                        <th>Escolaridad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.nucleo_familiar_ids" t-as="fam">
                                        <tr>
                                            <td><span t-field="fam.grupo_nucleo"/></td>
                                            <td><span t-field="fam.sexo_nucleo"/></td>
                                            <td><span t-field="fam.edad_nucleo"/></td>
                                            <td><span t-field="fam.escolaridad"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not doc.nucleo_familiar_ids">
                                        <tr>
                                            <td colspan="4" style="color: #9e9e9e; font-style: italic;">
                                                No se registraron miembros del núcleo familiar.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Fotos de Equipos -->
                            <div class="foto-contenedor" style="margin-top: 14px;">
                                <div class="foto-header">📷 Fotografías de los Equipos del Hogar</div>
                                <div class="foto-cuerpo">
                                    <t t-if="doc.foto_equipo_1 or doc.foto_equipo_2">
                                        <div class="equipos-fotos">
                                            <t t-if="doc.foto_equipo_1">
                                                <img t-att-src="image_data_uri(doc.foto_equipo_1)"
                                                     alt="Equipo 1"
                                                     style="width:100%; border-radius:4px; border:1px solid #cfd8dc;"/>
                                            </t>
                                            <t t-if="doc.foto_equipo_2">
                                                <img t-att-src="image_data_uri(doc.foto_equipo_2)"
                                                     alt="Equipo 2"
                                                     style="width:100%; border-radius:4px; border:1px solid #cfd8dc;"/>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="foto-placeholder">
                                            No se adjuntaron fotografías de equipos.
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 4 — ASPECTOS LIMITANTES
                        ══════════════════════════════════════════ -->
                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">4</div>
                                <h4>Aspectos Limitantes (Prioridad)</h4>
                            </div>
                            <div class="limitantes-grid">
                                <div class="limitante-item">
                                    <span>Energía Eléctrica</span>
                                    <span class="prio" t-field="doc.limit_energia"/>
                                </div>
                                <div class="limitante-item">
                                    <span>Seguridad</span>
                                    <span class="prio" t-field="doc.limit_seguridad"/>
                                </div>
                                <div class="limitante-item">
                                    <span>Meteorología</span>
                                    <span class="prio" t-field="doc.limit_meteorologia"/>
                                </div>
                                <div class="limitante-item">
                                    <span>Falta de Mano de Obra</span>
                                    <span class="prio" t-field="doc.limit_mano_obra"/>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 5 — CRITERIOS DE SELECCIÓN
                        ══════════════════════════════════════════ -->
                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">5</div>
                                <h4>Criterios de Selección</h4>
                            </div>
                            <div class="criterios-grid">
                                <div class="criterio-fila">
                                    <span>Condición socioeconómica de la mujer</span>
                                    <span class="val" t-field="doc.criterio_mujer"/>
                                </div>
                                <div class="criterio-fila">
                                    <span>Número de beneficiarios</span>
                                    <span class="val" t-field="doc.criterio_beneficiario"/>
                                </div>
                                <div class="criterio-fila">
                                    <span>Condiciones de seguridad</span>
                                    <span class="val" t-field="doc.criterio_seguridad"/>
                                </div>
                                <div class="criterio-fila">
                                    <span>Disponibilidad de equipos</span>
                                    <span class="val" t-field="doc.criterio_disponibilidad"/>
                                </div>
                                <div class="criterio-fila">
                                    <span>Uso productivo de la energía</span>
                                    <span class="val" t-field="doc.criterio_uso_productivo"/>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             DICTAMEN FINAL
                        ══════════════════════════════════════════ -->
                        <div class="dictamen">
                            <label>Dictamen del Sistema</label>
                            <p t-field="doc.observacion_automatica"/>
                            <label>Aprovechamiento Propuesto</label>
                            <p t-field="doc.aprovechamiento_energia"/>
                            <t t-if="doc.emprende_negocio == 'si'">
                                <label>Negocio a Emprender</label>
                                <p t-field="doc.negocio_descripcion"/>
                            </t>
                        </div>

                        <!-- ══════════════════════════════════════════
                             CROQUIS DE LA VIVIENDA  (al final)
                        ══════════════════════════════════════════ -->
                        <p style="page-break-before: always;"> </p>

                        <div class="seccion">
                            <div class="seccion-titulo">
                                <div class="seccion-num">✎</div>
                                <h4>Croquis de la Vivienda</h4>
                            </div>
                            <div class="croquis-contenedor">
                                <t t-if="doc.foto_croquis">
                                    <img t-att-src="image_data_uri(doc.foto_croquis)"
                                         alt="Croquis de la vivienda"/>
                                </t>
                                <t t-else="">
                                    <div class="foto-placeholder">
                                        No se adjuntó croquis de la vivienda.
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div><!-- /page -->
                </t>
            </t>
        </t>
    </template>
</odoo>