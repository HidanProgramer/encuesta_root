<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_encuesta_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">

                    <style>
                        /* ═══════════════════════════════════════════
                           CSS COMPATIBLE CON wkhtmltopdf
                           SIN: CSS variables, grid, flexbox, object-fit
                           CON: tablas HTML, colores hex directos, inline styles
                        ═══════════════════════════════════════════ */

                        body, .page {
                            font-family: Arial, sans-serif;
                            font-size: 12px;
                            color: #263238;
                            background: #ffffff;
                        }

                        #wkhtmltopdf_or_wkprice_header {
                            display: none !important;
                        }

                        /* ── Encabezado ── */
                        .enc-tabla {
                            width: 100%;
                            border-collapse: collapse;
                            border: 2px solid #0d3b6e;
                            margin-bottom: 18px;
                        }
                        .enc-franja {
                            width: 8px;
                            background-color: #0d3b6e;
                        }
                        .enc-cuerpo {
                            padding: 12px 16px;
                        }
                        .enc-titulo {
                            font-size: 15px;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                            color: #0d3b6e;
                            margin: 0 0 3px 0;
                        }
                        .enc-sub {
                            font-size: 11px;
                            color: #546e7a;
                            margin: 0 0 8px 0;
                        }
                        .enc-meta-tabla {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .enc-meta-tabla td {
                            padding: 2px 12px 2px 0;
                            vertical-align: top;
                        }
                        .meta-lbl {
                            display: block;
                            font-size: 8px;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: #546e7a;
                            margin-bottom: 1px;
                        }
                        .meta-val {
                            font-size: 11px;
                            font-weight: bold;
                            color: #263238;
                        }
                        .badge {
                            display: inline-block;
                            padding: 2px 8px;
                            border: 1px solid #1565c0;
                            font-size: 9px;
                            font-weight: bold;
                            text-transform: uppercase;
                            color: #1565c0;
                            background-color: #e8f0fe;
                        }

                        /* ── Sección titulo ── */
                        .sec-tabla {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 8px;
                            border-bottom: 2px solid #1565c0;
                        }
                        .sec-num {
                            width: 24px;
                            background-color: #1565c0;
                            color: #ffffff;
                            font-size: 10px;
                            font-weight: bold;
                            text-align: center;
                            padding: 3px;
                        }
                        .sec-titulo {
                            padding: 4px 8px;
                            font-size: 11px;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: #0d3b6e;
                        }

                        /* ── Tablas de datos ── */
                        .tabla-datos {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 11px;
                            margin-bottom: 10px;
                        }
                        .tabla-datos th {
                            background-color: #0d3b6e;
                            color: #ffffff;
                            padding: 6px 8px;
                            text-align: center;
                            font-size: 10px;
                            text-transform: uppercase;
                        }
                        .tabla-datos th.sub {
                            background-color: #1565c0;
                        }
                        .tabla-datos td {
                            padding: 5px 8px;
                            border-bottom: 1px solid #cfd8dc;
                            text-align: center;
                        }
                        .tabla-datos tr.par td {
                            background-color: #f4f6f9;
                        }

                        /* ── Bloques de info ── */
                        .info-tabla {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 10px;
                        }
                        .info-tabla td {
                            width: 50%;
                            padding: 4px;
                            vertical-align: top;
                        }
                        .info-bloque {
                            background-color: #f4f6f9;
                            border-left: 3px solid #1565c0;
                            padding: 7px 10px;
                        }
                        .info-lbl {
                            display: block;
                            font-size: 8px;
                            text-transform: uppercase;
                            letter-spacing: 0.6px;
                            color: #546e7a;
                            margin-bottom: 2px;
                        }
                        .info-val {
                            font-size: 11px;
                            font-weight: bold;
                            color: #263238;
                        }

                        /* ── Foto / Mapa contenedor ── */
                        .foto-caja {
                            border: 1px solid #cfd8dc;
                            margin-top: 10px;
                            margin-bottom: 10px;
                        }
                        .foto-hdr {
                            background-color: #f4f6f9;
                            border-bottom: 1px solid #cfd8dc;
                            padding: 4px 10px;
                            font-size: 9px;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 0.6px;
                            color: #546e7a;
                        }
                        .foto-hdr-mapa {
                            background-color: #e8f0fe;
                            border-bottom: 1px solid #1565c0;
                            padding: 4px 10px;
                            font-size: 9px;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 0.6px;
                            color: #1565c0;
                        }
                        .foto-body {
                            padding: 8px;
                            text-align: center;
                        }
                        .foto-placeholder {
                            padding: 14px;
                            border: 1px dashed #cfd8dc;
                            color: #90a4ae;
                            font-size: 10px;
                            font-style: italic;
                            text-align: center;
                        }

                        /* ── Limitantes y Criterios (tabla 2 columnas) ── */
                        .dos-col {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .dos-col td {
                            width: 50%;
                            padding: 3px 4px;
                            vertical-align: top;
                        }
                        .item-fila {
                            border: 1px solid #cfd8dc;
                            padding: 6px 10px;
                            font-size: 11px;
                        }
                        .item-val {
                            font-weight: bold;
                            color: #00897b;
                            float: right;
                        }
                        .criterio-val {
                            font-weight: bold;
                            color: #1565c0;
                            float: right;
                        }

                        /* ── Dictamen ── */
                        .dictamen {
                            background-color: #e8f0fe;
                            border-left: 4px solid #0d3b6e;
                            padding: 10px 14px;
                            margin-top: 14px;
                            font-size: 11px;
                        }
                        .dict-lbl {
                            display: block;
                            font-size: 8px;
                            text-transform: uppercase;
                            letter-spacing: 0.7px;
                            color: #546e7a;
                            margin-top: 8px;
                            margin-bottom: 2px;
                        }
                        .dict-lbl:first-child { margin-top: 0; }
                        .dict-val {
                            margin: 0;
                            font-weight: bold;
                            color: #263238;
                        }

                        /* ── Fotos de equipos (tabla 2 col) ── */
                        .equipos-tabla {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .equipos-tabla td {
                            width: 50%;
                            padding: 4px;
                            text-align: center;
                            vertical-align: top;
                        }
                    </style>

                    <div class="page" style="margin-top: 0px !important; padding-top: 0px !important;">

                        <!-- ══════════════════════════════════════════
                             ENCABEZADO
                        ══════════════════════════════════════════ -->
                        <table class="enc-tabla">
                            <tr>
                                <td class="enc-franja"> </td>
                                <td class="enc-cuerpo">
                                    <p class="enc-titulo">Expediente de Encuesta Técnica</p>
                                    <p class="enc-sub">
                                        Sistema Propuesto: <span t-field="doc.sistema_recomendado"/>
                                    </p>
                                    <table class="enc-meta-tabla">
                                        <tr>
                                            <td>
                                                <span class="meta-lbl">Cliente</span>
                                                <span class="meta-val" t-field="doc.cliente"/>
                                            </td>
                                            <td>
                                                <span class="meta-lbl">C.I.</span>
                                                <span class="meta-val" t-field="doc.ci"/>
                                            </td>
                                            <td>
                                                <span class="meta-lbl">Fecha de Encuesta</span>
                                                <span class="meta-val" t-field="doc.fecha_enc"/>
                                            </td>
                                            <td>
                                                <span class="meta-lbl">Estado</span>
                                                <span class="badge" t-field="doc.estado_evaluacion"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 1 — UBICACIÓN
                        ══════════════════════════════════════════ -->
                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num">1</td>
                                <td class="sec-titulo">Ubicación de la Vivienda</td>
                            </tr>
                        </table>

                        <table class="tabla-datos">
                            <thead>
                                <tr>
                                    <th>Municipio</th>
                                    <th>Consejo Popular</th>
                                    <th>Comunidad</th>
                                    <th>Latitud</th>
                                    <th>Longitud</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="doc.municipio_id.name"/></td>
                                    <td><span t-field="doc.consejo_popular_id.name"/></td>
                                    <td><span t-field="doc.comunidad_id.name"/></td>
                                    <td><span t-field="doc.latitud"/></td>
                                    <td><span t-field="doc.longitud"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Foto vivienda -->
                        <div class="foto-caja">
                            <div class="foto-hdr">Fotografia de la Vivienda</div>
                            <div class="foto-body">
                                <t t-if="doc.foto_vivienda_ids">
                                    <t t-set="fv" t-value="doc.foto_vivienda_ids[0]"/>
                                    <img t-att-src="'/web/image/%s' % fv.id"
                                         style="max-width:100%; max-height:200px; width:auto; height:auto;"/>
                                </t>
                                <t t-else="">
                                    <div class="foto-placeholder">No se adjunto fotografia de la vivienda.</div>
                                </t>
                            </div>
                        </div>

                        <!-- Mapa -->
                        <div class="foto-caja" style="border-color: #1565c0;">
                            <div class="foto-hdr-mapa">Mapa de Ubicacion</div>
                            <div class="foto-body">
                                <t t-if="doc.mapa_imagen">
                                    <img t-att-src="image_data_uri(doc.mapa_imagen)"
                                         style="max-width:100%; max-height:200px; width:auto; height:auto;"/>
                                    <p style="font-size:8px; color:#546e7a; margin:4px 0 0 0;">
                                        Maps by LocationIQ.com
                                    </p>
                                </t>
                                <t t-else="">
                                    <div class="foto-placeholder">El mapa se generara automaticamente al guardar.</div>
                                </t>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 2 — CARACTERÍSTICAS DE LA VIVIENDA
                        ══════════════════════════════════════════ -->
                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num">2</td>
                                <td class="sec-titulo">Caracteristicas de la Vivienda</td>
                            </tr>
                        </table>

                        <table class="info-tabla">
                            <tr>
                                <td>
                                    <div class="info-bloque">
                                        <span class="info-lbl">Tipo de Vivienda</span>
                                        <span class="info-val" t-field="doc.tipo_vivienda"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="info-bloque">
                                        <span class="info-lbl">Condicion General</span>
                                        <span class="info-val" t-field="doc.condicion_vivienda"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="info-bloque">
                                        <span class="info-lbl">Materiales</span>
                                        <span class="info-val">
                                            <t t-if="doc.material_madera">Madera </t>
                                            <t t-if="doc.material_mamposteria">Mamposteria </t>
                                            <t t-if="doc.material_otro"><span t-field="doc.otro_material"/></t>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="info-bloque">
                                        <span class="info-lbl">Divisiones Internas</span>
                                        <span class="info-val">
                                            <t t-if="doc.divisiones">
                                                <t t-if="doc.sala">Sala </t>
                                                <t t-if="doc.comedor">Comedor </t>
                                                <t t-if="doc.cocina">Cocina </t>
                                                <t t-if="doc.cuartos">Cuartos </t>
                                                <t t-if="doc.banos">Banos</t>
                                            </t>
                                            <t t-else="">No posee</t>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                            <t t-if="doc.tipo_vivienda == 'finca'">
                                <tr>
                                    <td colspan="2">
                                        <div class="info-bloque">
                                            <span class="info-lbl">Tipo de Actividad (Finca)</span>
                                            <span class="info-val" t-field="doc.tipo_finca"/>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </table>

                        <!-- Salto de página -->
                        <p style="page-break-before: always;"> </p>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 3 — NÚCLEO FAMILIAR
                        ══════════════════════════════════════════ -->
                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num">3</td>
                                <td class="sec-titulo">Servicio Electrico y Nucleo Familiar</td>
                            </tr>
                        </table>

                        <div class="info-bloque" style="margin-bottom:10px;">
                            <span class="info-lbl">Tipo de Servicio Energetico Actual</span>
                            <span class="info-val" t-field="doc.tipo_servicio_energetico"/>
                        </div>

                        <table class="tabla-datos">
                            <thead>
                                <tr>
                                    <th colspan="4">
                                        Miembros del Hogar — Total:
                                        <span t-field="doc.total_personas"/> personas
                                    </th>
                                </tr>
                                <tr>
                                    <th class="sub">Parentesco / Grupo</th>
                                    <th class="sub">Sexo</th>
                                    <th class="sub">Edad</th>
                                    <th class="sub">Escolaridad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.nucleo_familiar_ids" t-as="fam">
                                    <tr t-att-class="'par' if fam_index % 2 == 1 else ''">
                                        <td><span t-field="fam.grupo_nucleo"/></td>
                                        <td><span t-field="fam.sexo_nucleo"/></td>
                                        <td><span t-field="fam.edad_nucleo"/></td>
                                        <td><span t-field="fam.escolaridad"/></td>
                                    </tr>
                                </t>
                                <t t-if="not doc.nucleo_familiar_ids">
                                    <tr>
                                        <td colspan="4" style="color:#90a4ae; font-style:italic;">
                                            No se registraron miembros del nucleo familiar.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Fotos de equipos -->
                        <div class="foto-caja">
                            <div class="foto-hdr">Fotografias de los Equipos del Hogar</div>
                            <div class="foto-body">
                                <t t-if="doc.foto_equipo_ids">
                                    <table class="equipos-tabla">
                                        <t t-foreach="doc.foto_equipo_ids" t-as="eq">
                                            <t t-if="eq_index % 2 == 0">
                                                <tr>
                                                    <!-- Foto Izquierda (siempre existe) -->
                                                    <td>
                                                    <img t-att-src="'/web/image/%s' % eq.id"
                                                        style="max-width:100%; max-height:200px; width:auto; height:auto; border:1px solid #cfd8dc;"/>
                                                    </td>
                                                    <!-- Foto derecha (puede no existir en la última fila impar) -->
                                                    <t t-if="eq_index + 1 &lt; len(doc.foto_equipo_ids)">
                                                        <t t-set="eq2" t-value="doc.foto_equipo_ids[eq_index + 1]"/>
                                                            <td style="width:50%; padding:4px; text-align:center; vertical-align:top;">
                                                                <img t-att-src="'/web/image/%s' % eq2.id"
                                                                style="max-width:100%; max-height:200px; width:auto; height:auto; border:1px solid #cfd8dc;"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <!-- Celda Vacia para mantener el Layout cuando hay un numero impar de fotos -->
                                                         <td style="width:50%;"> </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </t>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="foto-placeholder">No se adjuntaron fotografias de equipos.</div>
                                </t>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 4 — ASPECTOS LIMITANTES
                        ══════════════════════════════════════════ -->
                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num">4</td>
                                <td class="sec-titulo">Aspectos Limitantes (Prioridad)</td>
                            </tr>
                        </table>

                        <table class="dos-col">
                            <tr>
                                <td>
                                    <div class="item-fila">
                                        Energia Electrica
                                        <span class="item-val" t-field="doc.limit_energia"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="item-fila">
                                        Seguridad
                                        <span class="item-val" t-field="doc.limit_seguridad"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="item-fila">
                                        Meteorologia
                                        <span class="item-val" t-field="doc.limit_meteorologia"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="item-fila">
                                        Falta de Mano de Obra
                                        <span class="item-val" t-field="doc.limit_mano_obra"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══════════════════════════════════════════
                             SECCIÓN 5 — CRITERIOS DE SELECCIÓN
                        ══════════════════════════════════════════ -->
                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num">5</td>
                                <td class="sec-titulo">Criterios de Seleccion</td>
                            </tr>
                        </table>

                        <table class="dos-col">
                            <tr>
                                <td>
                                    <div class="item-fila">
                                        Condicion socioeconomica de la mujer
                                        <span class="criterio-val" t-field="doc.criterio_mujer"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="item-fila">
                                        Numero de beneficiarios
                                        <span class="criterio-val" t-field="doc.criterio_beneficiario"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="item-fila">
                                        Condiciones de seguridad
                                        <span class="criterio-val" t-field="doc.criterio_seguridad"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="item-fila">
                                        Disponibilidad de equipos
                                        <span class="criterio-val" t-field="doc.criterio_disponibilidad"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="item-fila">
                                        Uso productivo de la energia
                                        <span class="criterio-val" t-field="doc.criterio_uso_productivo"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══════════════════════════════════════════
                             DICTAMEN FINAL
                        ══════════════════════════════════════════ -->
                        <div class="dictamen">
                            <span class="dict-lbl">Dictamen del Sistema</span>
                            <p class="dict-val" t-field="doc.observacion_automatica"/>
                            <span class="dict-lbl">Aprovechamiento Propuesto</span>
                            <p class="dict-val" t-field="doc.aprovechamiento_energia"/>
                            <t t-if="doc.emprende_negocio == 'si'">
                                <span class="dict-lbl">Negocio a Emprender</span>
                                <p class="dict-val" t-field="doc.negocio_descripcion"/>
                            </t>
                        </div>

                        <!-- ══════════════════════════════════════════
                             CROQUIS (página final)
                        ══════════════════════════════════════════ -->
                        <p style="page-break-before: always;"> </p>

                        <table class="sec-tabla">
                            <tr>
                                <td class="sec-num" style="font-size:12px;">&#9998;</td>
                                <td class="sec-titulo">Croquis de la Vivienda</td>
                            </tr>
                        </table>

                        <div class="foto-caja">
                            <div class="foto-hdr">Croquis</div>
                            <div class="foto-body">
                                <t t-if="doc.foto_croquis_ids">
                                    <t t-set="cq" t-value="doc.foto_croquis_ids[0]"/>
                                    <img t-att-src="'/web/image/%s' % cq.id"
                                         style="max-width:150%; max-height:350px; width:auto; height:auto;"/>
                                </t>
                                <t t-else="">
                                    <div class="foto-placeholder">No se adjunto croquis de la vivienda.</div>
                                </t>
                            </div>
                        </div>

                    </div><!-- /page -->
                </t>
            </t>
        </t>
    </template>
</odoo>