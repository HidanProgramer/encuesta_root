<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_encuesta_nucleo_inherit" model="ir.ui.view">
        <field name="name">encuesta.nucleo.inherit</field>
        <field name="model">clientes.encuesta</field>
        <field name="inherit_id" ref="encuesta_root.view_clientes_encuesta_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='tab_nucleo']" position="inside">
                <group>
                    <group string="Miembros del Hogar">
                        <field name="nucleo_familiar_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="grupo_nucleo"/>
                                <field name="sexo_nucleo"/>
                                <field name="edad_nucleo"/>
                                <field name="escolaridad"/>
                            </list>
                        </field>
                    </group>
                    <group string="Información del Núcleo Familiar">
                        <field name="total_personas" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>