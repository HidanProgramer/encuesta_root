<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_encuesta_graph_estado" model="ir.ui.view">
        <field name="name">encuesta.graph.estado</field>
        <field name="model">clientes.encuesta</field>
        <field name="arch" type="xml">
            <graph string="Estado de Evaluación" type="pie" sample="1">
                <field name="estado_evaluacion" type="row"/>
                <field name="sistema_recomendado" type="col"/>
            </graph>
        </field>
    </record>
    
    <record id="view_clientes_encuesta_bar_municipio" model="ir.ui.view">
        <field name="name">clientes.encuesta.bar.municipio</field>
        <field name="model">clientes.encuesta</field>
        <field name="arch" type="xml">
            <graph string="Sistemas por Municipio" type="bar" stacked="1" sample="1">
                <field name="municipio" type="row"/>
                <field name="sistema_recomendado" type="col"/>
            </graph>
        </field>
    </record>

    <record id="view_encuesta_pivot" model="ir.ui.view">
        <field name="name">encuesta.graph.pivot</field>
        <field name="model">clientes.encuesta</field>
        <field name="arch" type="xml">
            <pivot string="Tabla de Análisis de Encuestas" sample="1">
                <field name="municipio" type="row"/>
                <field name="estado_evaluacion" type="row"/>
                <field name="sistema_recomendado" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_encuesta_graph_servicio_energetico" model="ir.ui.view">
        <field name="name">encuesta.graph.servicio.energetico</field>
        <field name="model">clientes.encuesta</field>
        <field name="arch" type="xml">
            <graph string="Distribución del Servicio Energético" type="bar">
                <field name="tipo_servicio_energetico" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_encuesta_graph_tipo_vivienda" model="ir.ui.view">
        <field name="name">encuesta.graph.tipo.vivienda</field>
        <field name="model">clientes.encuesta</field>
        <field name="arch" type="xml">
            <graph string="Distribución de Tipo de Viviendas" type="bar">
                <field name="tipo_vivienda" type="row"/>
            </graph>
        </field>
    </record>
</odoo>