<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    
    <t t-name="encuesta_root.DashboardChartTemplate">
        <div style="position: relative; height: 260px; width: 100%;">
            <canvas t-ref="chartCanvas" style="cursor: pointer;"/>
        </div>
    </t>

    <t t-name="encuesta_root.ClientesDashboardTemplate">
        <div class="o_content h-100 overflow-auto p-4" style="background-color: #f4f6f9;">
            
            <div class="row mb-4 align-items-center">
                <div class="col">
                    <h2 class="fw-bold text-dark mb-1">Dashboard de Control Fotovoltaico</h2>
                    <p class="text-muted small mb-0">Análisis estadístico e indicadores de auto-consumo y solicitudes.</p>
                </div>
                <div class="col-auto">
                    <button class="btn btn-white bg-white shadow-sm text-dark border" t-on-click="loadDashboardData">
                        <i class="fa fa-refresh me-1 text-primary"></i> Sincronizar Datos
                    </button>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.openListView([], 'Todas las Encuestas')">
                    <div class="card border-0 shadow-sm p-3 cursor-pointer" style="border-left: 4px solid #0d6efd !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-bold">Total Encuestas</span>
                                <h3 class="fw-bold mb-0 mt-1"><t t-esc="state.cards.total_encuestas"/></h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 text-primary rounded p-3"><i class="fa fa-file-text fa-2x"/></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.openListView([['estado_evaluacion', '=', 'aprobado']], 'Casos Aprobados')">
                    <div class="card border-0 shadow-sm p-3 cursor-pointer" style="border-left: 4px solid #28a745 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-bold">Aprobados Total</span>
                                <h3 class="fw-bold text-success mb-0 mt-1"><t t-esc="state.cards.total_aprobados"/></h3>
                            </div>
                            <div class="bg-success bg-opacity-10 text-success rounded p-3"><i class="fa fa-check-circle fa-2x"/></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.openListView([['sistema_recomendado', '=', '1kw']], 'Sistemas 1 kW')">
                    <div class="card border-0 shadow-sm p-3 cursor-pointer" style="border-left: 4px solid #ffc107 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-bold">Sistemas 1 kW</span>
                                <h3 class="fw-bold text-warning mb-0 mt-1"><t t-esc="state.cards.total_1kw"/></h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 text-warning rounded p-3"><i class="fa fa-sun-o fa-2x"/></div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.openListView([['sistema_recomendado', '=', '2kw']], 'Sistemas 2 kW')">
                    <div class="card border-0 shadow-sm p-3 cursor-pointer" style="border-left: 4px solid #0dcaf0 !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-bold">Sistemas 2 kW</span>
                                <h3 class="fw-bold text-info mb-0 mt-1"><t t-esc="state.cards.total_2kw"/></h3>
                            </div>
                            <div class="bg-info bg-opacity-10 text-info rounded p-3"><i class="fa fa-bolt fa-2x"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3 small text-uppercase tracking-wider">Distribución por Tipo de Sistema</h5>
                        <DashboardChart type="'pie'" data="sistemaChartData" onChartClick.bind="onSistemaChartClick"/>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3 small text-uppercase tracking-wider">Estado de Electrificación Inicial</h5>
                        <DashboardChart type="'doughnut'" data="electrificacionChartData" onChartClick.bind="onElectrificacionChartClick"/>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3 small text-uppercase tracking-wider">Capacidad de Sistemas por Municipio</h5>
                        <DashboardChart type="'bar'" data="municipiosChartData" onChartClick.bind="onMunicipiosChartClick" options="{responsive: true,
                        plugins: {legend: {position: 'bottom'}}, scales: {x: {stacked: true} , y: {beginAtZero: true, stacked: true}}}"/>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-3 h-100">
                        <h5 class="fw-bold text-dark mb-3 small text-uppercase tracking-wider">Estado Resolutivo de Evaluaciones</h5>
                        <DashboardChart type="'pie'" data="evaluacionChartData" onChartClick.bind="onEvaluacionChartClick"/>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
